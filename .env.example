# Specson Billing — Environment Variables
# Copy this file to .env and fill in your values before running.
# Admin contact: Specson3@gmail.com (Matheshwaran.S)

VITE_API_URL=http://localhost:5000/api

# WhatsApp business number in E.164 format — India (+91), no spaces or dashes
# Example: 919876543210  (country code 91 + 10-digit Indian mobile)
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin portal credentials (set in Supabase or your auth provider)
VITE_ADMIN_ID=
VITE_ADMIN_PASSWORD=
VITE_STAFF_ID=
VITE_STAFF_PASSWORD=
